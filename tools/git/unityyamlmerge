#!/usr/bin/env sh
# Git merge driver wrapper for Unity's SmartMerge (UnityYAMLMerge).
#
# Called by git as:  sh tools/git/unityyamlmerge %O %B %A %A
#                                                base theirs ours dest
#
# Why this wrapper exists
# -----------------------
# .gitattributes marks every Unity asset type (*.unity, *.prefab, *.asset,
# *.mat, *.meta, ...) with `merge=unityyamlmerge`. If that driver is not
# defined in a contributor's LOCAL git config, git does not fall back to a
# text merge -- it aborts with:
#
#     fatal: custom merge driver unityyamlmerge lacks command line.
#
# Git config cannot be committed (by design: it can execute arbitrary
# commands), so the driver has to be wired up per clone. This wrapper makes
# that wiring portable: it is committed to the repo, resolves the Unity
# install itself, and degrades to a normal text conflict instead of a fatal
# error when Unity is not installed.
#
# Resolution order:
#   1. $UNITY_YAML_MERGE                        (explicit override)
#   2. editor matching ProjectSettings/ProjectVersion.txt
#   3. newest editor found under a known Hub root
#   4. no tool  ->  git merge-file (ordinary conflict markers, exit 1)
#
# Deliberately does NOT shell out to the `unity` CLI: as of CLI 1.0.0-beta.3
# several subcommands print their result and then fail to exit, which would
# hang git indefinitely mid-merge.

set -u

# `--probe` reports which tool would be used and exits. Used by setup.sh and
# handy for debugging a contributor's machine. Must be handled before the
# positional args are read, since probing passes no merge arguments.
PROBE=0
if [ "${1:-}" = "--probe" ]; then
    PROBE=1
else
    if [ $# -lt 3 ]; then
        echo "usage: $0 <base> <theirs> <ours> [dest]" >&2
        echo "       $0 --probe" >&2
        echo "This is a git merge driver/mergetool; it's not meant to be run directly" >&2
        echo "with fewer than 3 arguments. See .gitconfig-unity for how it's wired up." >&2
        exit 1
    fi
    BASE=$1
    THEIRS=$2
    OURS=$3
    DEST=${4:-$3}
fi

find_merge_tool() {
    if [ -n "${UNITY_YAML_MERGE:-}" ] && [ -x "${UNITY_YAML_MERGE}" ]; then
        printf '%s' "${UNITY_YAML_MERGE}"
        return 0
    fi

    _ver=""
    if [ -f ProjectSettings/ProjectVersion.txt ]; then
        _ver=$(sed -n 's/^m_EditorVersion: *//p' ProjectSettings/ProjectVersion.txt | tr -d '\r')
    fi

    for _root in \
        "/c/Program Files/Unity/Hub/Editor" \
        "/c/Program Files (x86)/Unity/Hub/Editor" \
        "/mnt/c/Program Files/Unity/Hub/Editor" \
        "/mnt/c/Program Files (x86)/Unity/Hub/Editor" \
        "${HOME}/Unity/Hub/Editor" \
        "/Applications/Unity/Hub/Editor" \
        "/opt/unity/Hub/Editor"
    do
        [ -d "${_root}" ] || continue

        # Exact project version first, then newest installed as a fallback.
        # `sort -V` is a GNU extension; BSD sort (macOS default) rejects it
        # with "illegal option -- V" and would otherwise silently drop this
        # fallback. Probe for support and fall back to plain sort.
        if echo | sort -V >/dev/null 2>&1; then
            _newest=$(ls -1d "${_root}"/* 2>/dev/null | sort -V | tail -1)
        else
            _newest=$(ls -1d "${_root}"/* 2>/dev/null | sort | tail -1)
        fi
        for _editor in "${_root}/${_ver}" "${_newest}"; do
            [ -n "${_editor}" ] && [ -d "${_editor}" ] || continue
            for _rel in \
                "Editor/Data/Tools/UnityYAMLMerge.exe" \
                "Editor/Data/Tools/UnityYAMLMerge" \
                "Unity.app/Contents/Tools/UnityYAMLMerge"
            do
                if [ -x "${_editor}/${_rel}" ]; then
                    printf '%s' "${_editor}/${_rel}"
                    return 0
                fi
            done
        done
    done

    return 1
}

TOOL=$(find_merge_tool) || TOOL=""

if [ "${PROBE}" -eq 1 ]; then
    if [ -n "${TOOL}" ]; then
        echo "UnityYAMLMerge found: ${TOOL}"
        exit 0
    fi
    echo "UnityYAMLMerge not found - merges will fall back to plain text conflicts." >&2
    exit 1
fi

if [ -n "${TOOL}" ]; then
    # -h and --fallback none are what keep this usable as a merge driver. Both
    # close a path where UnityYAMLMerge blocks on a GUI and takes git with it:
    #
    #   -h              headless. Without it, a file it cannot parse raises a
    #                   modal "not a valid text serialized YAML file" dialog and
    #                   the process sits there until someone clicks OK. During
    #                   `git merge` that is an indefinite hang, and in CI there
    #                   is nobody to click. With -h the same message goes to
    #                   stderr and it exits 1, which git handles as a conflict.
    #
    #   --fallback none the shipped mergespecfile.txt lists GUI tools to hand
    #                   unresolved conflicts to -- Beyond Compare, p4merge,
    #                   Araxis (with /wait), PlasticSCM, DiffMerge, FileMerge.
    #                   Whichever is installed gets launched, so merge behaviour
    #                   would otherwise depend on what a contributor happens to
    #                   have on their machine, and any of them blocks the merge.
    #
    # Someone who wants interactive resolution should configure a git mergetool
    # directly rather than have one appear mid-merge.
    #
    # A TOOL ending in .exe/.EXE is a native Windows binary; under WSL it's
    # reached over the interop mount and can't resolve the paths git hands it
    # -- those are WSL-side (a temp file under /tmp, or the working tree under
    # the Linux filesystem), not anything the Windows side can open directly.
    # Gate on the extension rather than a /mnt/ path prefix: WSL lets
    # /etc/wsl.conf remount Windows drives at a custom root (e.g. /c/ instead
    # of /mnt/c/), so a prefix check misses those configs. Gate on wslpath's
    # presence too, both because that's what does the translating and because
    # it is otherwise the only reliable "are we actually under WSL" signal --
    # native Windows Git Bash resolves the same *.exe path but has no wslpath,
    # so this stays a no-op there. And check the extension at all rather than
    # firing on any wslpath-having environment: Unity also ships a native
    # Linux Editor, and a Linux ELF binary found by find_merge_tool() while
    # running inside WSL already gets native paths and needs no translation.
    case "${TOOL}" in
        *.exe|*.EXE)
            if command -v wslpath >/dev/null 2>&1; then
                _wbase=$(wslpath -m "${BASE}" 2>/dev/null) && BASE=${_wbase}
                _wtheirs=$(wslpath -m "${THEIRS}" 2>/dev/null) && THEIRS=${_wtheirs}
                _wours=$(wslpath -m "${OURS}" 2>/dev/null) && OURS=${_wours}
                _wdest=$(wslpath -m "${DEST}" 2>/dev/null) && DEST=${_wdest}
            fi
            ;;
    esac

    # `-h` only covers errors raised once `merge` has been accepted. Anything
    # that fails earlier -- in argument parsing -- still raises a modal dialog
    # and waits forever, and no flag turns that off, because the flag is an
    # option of the subcommand that never got parsed. Verified: invoking the
    # tool with no subcommand blocks indefinitely whether output goes to a
    # terminal or a file, and blocks with `-h` too.
    #
    # This wrapper always passes `merge` first, so it should never reach that
    # state. `should never` is exactly the assumption worth bounding when the
    # failure mode is git hanging with no output, so cap the call where the
    # shell can. `timeout` is GNU coreutils: present in Git Bash, WSL and
    # Linux, absent from a stock macOS, hence the probe rather than a bare
    # call.
    if command -v timeout >/dev/null 2>&1; then
        timeout "${UNITY_YAML_MERGE_TIMEOUT:-300}" \
            "${TOOL}" merge -h -p --force --fallback none \
            "${BASE}" "${THEIRS}" "${OURS}" "${DEST}"
        rc=$?
        if [ "${rc}" -eq 124 ]; then
            echo "unityyamlmerge: UnityYAMLMerge did not return within ${UNITY_YAML_MERGE_TIMEOUT:-300}s and was killed." >&2
            echo "                It may have been waiting on a dialog. Treating this as a" >&2
            echo "                conflict; resolve ${DEST} by hand." >&2
            echo "                Set UNITY_YAML_MERGE_TIMEOUT to change the limit." >&2
        fi
        exit "${rc}"
    fi

    "${TOOL}" merge -h -p --force --fallback none \
        "${BASE}" "${THEIRS}" "${OURS}" "${DEST}"
    exit $?
fi

# ---- Fallback -------------------------------------------------------------
# No Unity install found. Produce an ordinary text merge so the contributor
# gets conflict markers they can resolve by hand, rather than a fatal error
# that blocks the merge entirely.
echo "unityyamlmerge: UnityYAMLMerge not found - falling back to a plain text merge." >&2
echo "                Scene/prefab conflicts will need manual resolution." >&2
echo "                Set UNITY_YAML_MERGE=/path/to/UnityYAMLMerge to enable smart merging." >&2

# In driver mode DEST and OURS are the same path (see .gitconfig-unity's
# `%A %A`), so this is a no-op. In mergetool mode they differ ($LOCAL vs
# $MERGED) -- copy first and merge into DEST directly, rather than merging
# into OURS and copying afterward, so the wrapper never mutates a temp file
# ($LOCAL) it wasn't asked to write to.
if [ "${DEST}" != "${OURS}" ]; then
    if ! cp "${OURS}" "${DEST}"; then
        echo "unityyamlmerge: failed to copy ${OURS} to ${DEST}; aborting rather than" >&2
        echo "                merging against a stale or missing destination." >&2
        exit 1
    fi
fi

git merge-file -L ours -L base -L theirs "${DEST}" "${BASE}" "${THEIRS}"
rc=$?

exit ${rc}
