{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "unity-ecosystem",
  "description": "Multi-arm evaluation manifest for Unity CLI and MCP servers (Official, Community, Specialized & CLIs)",
  "arms": [
    {
      "id": "official-unity-cli",
      "name": "Official Unity CLI (com.unity.pipeline)",
      "type": "cli",
      "command": "unity",
      "env": {
        "MSYS_NO_PATHCONV": "1"
      },
      "health_check": "unity status --json"
    },
    {
      "id": "official-unity-mcp",
      "name": "Official Unity MCP (com.unity.ai.assistant)",
      "type": "mcp",
      "mcp_server": "unity-editor-mcp",
      "tool_prefix": "mcp__unity-editor-mcp__",
      "health_check": "unity status --json"
    },
    {
      "id": "coplay-mcp",
      "name": "CoplayDev Unity MCP",
      "type": "mcp",
      "mcp_server": "UnityMCP",
      "tool_prefix": "mcp__UnityMCP__",
      "setup_script": "tools/three-way-setup.sh",
      "health_check": "curl -s http://127.0.0.1:8080/mcp"
    },
    {
      "id": "ivanmurzak-mcp",
      "name": "IvanMurzak C# Plugin MCP",
      "type": "mcp",
      "mcp_server": "Unity-MCP",
      "tool_prefix": "mcp__ivanmurzak__",
      "health_check": "curl -s http://127.0.0.1:8082/mcp"
    },
    {
      "id": "anklebreaker-mcp",
      "name": "AnkleBreaker 268-Tool MCP",
      "type": "mcp",
      "mcp_server": "unity-mcp-server",
      "tool_prefix": "mcp__anklebreaker__",
      "health_check": "curl -s http://127.0.0.1:8083/mcp"
    },
    {
      "id": "smithery-toolkit-mcp",
      "name": "Smithery Unity Toolkit MCP",
      "type": "mcp",
      "mcp_server": "unity-editor-toolkit",
      "tool_prefix": "mcp__smithery_toolkit__",
      "health_check": "curl -s http://127.0.0.1:9500/mcp"
    },
    {
      "id": "realvirtual-mcp",
      "name": "game4automation RealVirtual Digital Twin MCP",
      "type": "mcp",
      "mcp_server": "io.realvirtual.mcp",
      "tool_prefix": "mcp__realvirtual__",
      "health_check": "curl -s http://127.0.0.1:8085/mcp"
    },
    {
      "id": "akiojin-cli",
      "name": "akiojin Rust Unity CLI",
      "type": "cli",
      "command": "unity-cli-rust",
      "health_check": "unity-cli-rust --version"
    },
    {
      "id": "youngwoo-cli",
      "name": "youngwoo Go Unity CLI",
      "type": "cli",
      "command": "unity-cli-go",
      "health_check": "unity-cli-go --version"
    },
    {
      "id": "hatayama-loop",
      "name": "hatayama Autonomous Unity Dev Loop",
      "type": "cli",
      "command": "unity-cli-loop",
      "health_check": "unity-cli-loop --version"
    },
    {
      "id": "rage-cli",
      "name": "RageAgainstThePixel Unity CLI",
      "type": "cli",
      "command": "unity-cli",
      "health_check": "unity-cli --version"
    }
  ],
  "trial_defaults": {
    "concurrency": "serial",
    "scene_strategy": "auto",
    "timeout_seconds": 300
  },
  "traps_file": "traps.json"
}
